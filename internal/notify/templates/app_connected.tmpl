{{define "subject"}}{{if .AppAccessAdded}}{{t "email.app.subject_more" "{app} can now access more of your account" "app" .AppName}}{{else}}{{t "email.app.subject" "{app} can now access your account" "app" .AppName}}{{end}}{{end}}

{{define "text"}}{{template "hello" .}}

{{if .AppAccessAdded}}{{tp "email.app.intro_more" "You allowed the application <strong>{app}</strong> to receive more information from your {realm} account:" "app" .AppName "realm" .Realm}}{{else if .AppAccess}}{{tp "email.app.intro_and" "You allowed the application <strong>{app}</strong> to use your {realm} account. It receives who you are, and:" "app" .AppName "realm" .Realm}}{{else}}{{tp "email.app.intro" "You allowed the application <strong>{app}</strong> to use your {realm} account. It receives who you are." "app" .AppName "realm" .Realm}}{{end}}
{{range .AppAccess}}  - {{.}}
{{end}}
{{template "details.txt" .}}
{{t "email.nothing_to_do" "If this was you, there is nothing to do."}}

{{t "email.not_you" "Not you?"}} {{t "email.app.not_you" "Someone else is using your account: change your password now (it signs out every session) and ask your administrator to remove this application's access."}}
{{.ForgotPasswordURL}}
{{end}}

{{define "html"}}{{template "badge.info" (t "email.badge.apps" "Applications")}}
{{if .AppAccessAdded}}{{template "title" (t "email.app.subject_more" "{app} can now access more of your account" "app" .AppName)}}{{else}}{{template "title" (t "email.app.subject" "{app} can now access your account" "app" .AppName)}}{{end}}
{{template "hello" .}}
<p>{{if .AppAccessAdded}}{{th "email.app.intro_more" "You allowed the application <strong>{app}</strong> to receive more information from your {realm} account:" "app" .AppName "realm" .Realm}}{{else if .AppAccess}}{{th "email.app.intro_and" "You allowed the application <strong>{app}</strong> to use your {realm} account. It receives who you are, and:" "app" .AppName "realm" .Realm}}{{else}}{{th "email.app.intro" "You allowed the application <strong>{app}</strong> to use your {realm} account. It receives who you are." "app" .AppName "realm" .Realm}}{{end}}</p>
{{if .AppAccess}}<ul>{{range .AppAccess}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{template "details" .}}
<p>{{t "email.nothing_to_do" "If this was you, there is nothing to do."}}</p>
{{template "notyou" (t "email.app.not_you" "Someone else is using your account: change your password now (it signs out every session) and ask your administrator to remove this application's access.")}}
{{template "button" (button .ForgotPasswordURL (t "email.button.change_password" "Change my password"))}}
{{end}}
