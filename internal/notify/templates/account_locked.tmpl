{{define "subject"}}{{t "email.locked.subject" "Sign-in to your account is temporarily blocked"}}{{end}}

{{define "text"}}{{template "hello" .}}

{{tp "email.locked.intro" "After <strong>{attempts} wrong passwords</strong> in a row, sign-in to your {realm} account is blocked for {duration}, until <strong>{until}</strong>." "attempts" .FailedAttempts "realm" .Realm "duration" .LockDuration "until" .LockedUntil}}

{{t "email.locked.last_attempt" "Last attempt"}}:
{{template "details.txt" .}}
{{tp "email.locked.was_you" "<strong>Was it you?</strong> Wait and try again, or reset your password, which also unblocks your account right away."}}
{{.ForgotPasswordURL}}

{{t "email.not_you" "Not you?"}} {{t "email.locked.not_you" "Someone is probably trying to guess your password. They cannot sign in without it. If your password is short, or used on other sites, choose a new long one with the button above."}}
{{end}}

{{define "html"}}{{template "badge.warning" (t "email.badge.security" "Security")}}
{{template "title" (t "email.locked.title" "Sign-in is temporarily blocked")}}
{{template "hello" .}}
<p>{{th "email.locked.intro" "After <strong>{attempts} wrong passwords</strong> in a row, sign-in to your {realm} account is blocked for {duration}, until <strong>{until}</strong>." "attempts" .FailedAttempts "realm" .Realm "duration" .LockDuration "until" .LockedUntil}}</p>
<p style="font-size:13px;line-height:20px;color:#565b70;">{{t "email.locked.last_attempt" "Last attempt"}}</p>
{{template "details" .}}
<p>{{th "email.locked.was_you" "<strong>Was it you?</strong> Wait and try again, or reset your password, which also unblocks your account right away."}}</p>
{{template "button" (button .ForgotPasswordURL (t "email.button.reset_password" "Reset my password"))}}
{{template "notyou" (t "email.locked.not_you" "Someone is probably trying to guess your password. They cannot sign in without it. If your password is short, or used on other sites, choose a new long one with the button above.")}}
{{end}}
