{{define "subject"}}{{t "email.invite.subject" "Your {realm} account is ready" "realm" .Realm}}{{end}}

{{define "text"}}{{template "hello" .}}

{{tp "email.invite.intro" "An administrator created an account for you on <strong>{realm}</strong>. To start, choose your password. The link below works once and expires in <strong>{expires}</strong>." "realm" .Realm "expires" .ExpiresIn}}

{{.ResetURL}}

{{t "email.invite.expired" "If the link has expired, ask your administrator for a new one."}}
{{t "email.invite.ignore" "If you were not expecting this, you can ignore this e-mail: nobody can use the account until a password is chosen with this link."}}
{{end}}

{{define "html"}}{{template "badge.info" (t "email.badge.account" "Account")}}
{{template "title" (t "email.invite.title" "Your account is ready")}}
{{template "hello" .}}
<p>{{th "email.invite.intro" "An administrator created an account for you on <strong>{realm}</strong>. To start, choose your password. The link below works once and expires in <strong>{expires}</strong>." "realm" .Realm "expires" .ExpiresIn}}</p>
{{template "button" (button .ResetURL (t "email.invite.button" "Choose my password"))}}
{{template "link" .ResetURL}}
<p>{{t "email.invite.expired" "If the link has expired, ask your administrator for a new one."}}</p>
{{template "muted" (t "email.invite.ignore" "If you were not expecting this, you can ignore this e-mail: nobody can use the account until a password is chosen with this link.")}}
{{end}}
