{{define "subject"}}{{t "email.password_reset_required.subject" "Choose a new password"}}{{end}}

{{define "text"}}{{template "hello" .}}

{{tp "email.password_reset_required.intro" "An administrator requires a new password for your {realm} account and signed you out everywhere. You cannot sign in with your current password any more. The link below works once and expires in <strong>{expires}</strong>." "realm" .Realm "expires" .ExpiresIn}}

{{.ResetURL}}

{{template "details.txt" .}}
{{t "email.password_reset_required.expired" "Link expired? Use \"Forgot password\" on the sign-in page."}}

{{t "email.password_reset_required.not_expected" "If this surprises you, contact your administrator."}}
{{end}}

{{define "html"}}{{template "badge.warning" (t "email.badge.security" "Security")}}
{{template "title" (t "email.password_reset_required.subject" "Choose a new password")}}
{{template "hello" .}}
<p>{{th "email.password_reset_required.intro" "An administrator requires a new password for your {realm} account and signed you out everywhere. You cannot sign in with your current password any more. The link below works once and expires in <strong>{expires}</strong>." "realm" .Realm "expires" .ExpiresIn}}</p>
{{template "button" (button .ResetURL (t "email.password_reset.button" "Choose a new password"))}}
{{template "link" .ResetURL}}
{{template "details" .}}
<p>{{t "email.password_reset_required.expired" "Link expired? Use \"Forgot password\" on the sign-in page."}}</p>
{{template "muted" (t "email.password_reset_required.not_expected" "If this surprises you, contact your administrator.")}}
{{end}}
