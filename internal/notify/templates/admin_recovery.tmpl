{{define "subject"}}{{t "email.recovery.subject" "Security alert: admin recovery used on {realm}" "realm" .Realm}}{{end}}

{{define "text"}}{{template "hello" .}}

{{t "email.recovery.intro" "The emergency recovery procedure of the admin console was used."}}

  {{t "email.recovery.what" "What"}}: {{.RecoveryKind}}
  {{t "email.recovery.by" "By"}}: {{.RecoveryActor}} ({{t "email.recovery.cli" "command line on the admin server"}})
  {{t "email.details.when" "When"}}: {{.When}}
{{- if .RecoveryAccount}}
  {{t "email.recovery.new_account" "New admin account"}}: {{.RecoveryAccount}}
{{- end}}

{{t "email.recovery.why" "You receive this because you are an administrator of {realm}." "realm" .Realm}}
{{tp "email.recovery.not_planned" "<strong>Not planned?</strong> Treat it as an incident: check the audit log, disable the new account, and review who can reach the admin server."}}
{{end}}

{{define "html"}}{{template "badge.danger" (t "email.badge.alert" "Security alert")}}
{{template "title" (t "email.recovery.title" "Admin recovery was used")}}
{{template "hello" .}}
<p>{{t "email.recovery.intro" "The emergency recovery procedure of the admin console was used."}}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;">
<tr><td bgcolor="#fafbfd" style="padding:10px 16px;border:1px solid #e2e5ee;border-radius:8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:'IBM Plex Sans','Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;mso-line-height-rule:exactly;color:#565b70;">
<tr><td width="150" valign="top" style="padding:4px 0;">{{t "email.recovery.what" "What"}}</td><td valign="top" style="padding:4px 0;color:#13151f;">{{.RecoveryKind}}</td></tr>
<tr><td width="150" valign="top" style="padding:4px 0;">{{t "email.recovery.by" "By"}}</td><td valign="top" style="padding:4px 0;color:#13151f;"><span style="font-family:'IBM Plex Mono',SFMono-Regular,Consolas,Menlo,monospace;font-size:13px;">{{.RecoveryActor}}</span> <span style="color:#565b70;">({{t "email.recovery.cli" "command line on the admin server"}})</span></td></tr>
<tr><td width="150" valign="top" style="padding:4px 0;">{{t "email.details.when" "When"}}</td><td valign="top" style="padding:4px 0;color:#13151f;">{{.When}}</td></tr>
{{if .RecoveryAccount}}<tr><td width="150" valign="top" style="padding:4px 0;">{{t "email.recovery.new_account" "New admin account"}}</td><td valign="top" style="padding:4px 0;font-family:'IBM Plex Mono',SFMono-Regular,Consolas,Menlo,monospace;font-size:13px;color:#13151f;">{{.RecoveryAccount}}</td></tr>{{end}}
</table>
</td></tr>
</table>
<p>{{t "email.recovery.why" "You receive this because you are an administrator of {realm}." "realm" .Realm}}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0 0 0;">
<tr><td bgcolor="#fce8e8" style="padding:12px 16px;border-radius:8px;font-family:'IBM Plex Sans','Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;mso-line-height-rule:exactly;color:#13151f;">{{th "email.recovery.not_planned" "<strong>Not planned?</strong> Treat it as an incident: check the audit log, disable the new account, and review who can reach the admin server."}}</td></tr>
</table>
{{end}}
