# Admin console configuration: copy to .env.local (development) or pass as
# environment variables (Docker). Never commit the real values.

# --- printed by `idp-admin bootstrap` (make admin-bootstrap email=...) ---------
# Issuer of the master realm: <PUBLIC_URL of idp>/r/master
OIDC_ISSUER=http://localhost:8080/r/master
OIDC_CLIENT_ID=sso-admin
OIDC_CLIENT_SECRET=paste-the-secret-printed-by-the-bootstrap
# This console's public URL, as typed in the browser (redirect URI:
# ADMIN_URL/auth/callback, registered by the bootstrap with --admin-url).
ADMIN_URL=http://localhost:3000

# --- Admin API (cmd/idp-admin), reachable from this server only ----------------
ADMIN_API_URL=http://localhost:8090

# --- session cookie encryption key: openssl rand -base64 32 ---------------------
# Changing it signs every admin out.
SESSION_SECRET=

# --- realm opened after sign-in (default: master) --------------------------------
DEFAULT_REALM=master

# --- extra languages (optional, docs/I18N.md) -----------------------------------
# Directory of <tag>.json translation files (de.json, pt-br.json), read at
# start-up: they add languages, or change texts of the built-in ones (English,
# French), without a rebuild. A relative path starts from the console's working
# directory. A wrong file stops the console at start-up; check a directory with
# `npm run i18n:check -- --dir <path>`. The IdP has its own: LOCALES_DIR.
ADMIN_LOCALES_DIR=/admin/src/i18n/translations
