# Settings of Oh-My-SSO: cp .env.example .env (never committed).
#
# Local development (docs/GETTING-STARTED.md): the values below work as they
# are with `make dev`. make loads this file and exports it to the servers.
# Production with Docker Compose (docs/PRODUCTION.md): chmod 600 .env, and
# take the "Production:" value given under a setting. compose.yml passes this
# file to idp and idp-admin, and its other services take their values from it.
#
# Read by make and by docker compose: no quotes, no spaces around "=". A value
# may use ${NAME} of a line above it (see DATABASE_URL).
PORT=8080

# --- Docker images (compose.yml only) ---
# Tag of each image on Docker Hub, doctorpok/omsso:<image>-<tag>: latest, or
# the sha of a commit of main whose CI passed (a pinned version). Set by
# scripts/deploy.sh. IMAGE_MIGRATE holds the migrations of the same commit as
# IMAGE_IDP and IMAGE_IDP_ADMIN: keep the three on the same tag (unset, it
# follows IMAGE_IDP).
IMAGE_IDP=latest
IMAGE_IDP_ADMIN=latest
IMAGE_MIGRATE=latest
IMAGE_ADMIN=latest

# --- Client IP address (reverse proxy) ---
# Reverse proxies in front of cmd/idp (nginx, Traefik, a load balancer...),
# as IPs or CIDRs, comma separated. Only requests coming from them may tell
# the client's address (X-Forwarded-For); any other request is counted at
# its TCP address, whatever headers it sends. Unset = no proxy trusted: right
# when browsers connect directly, wrong behind a proxy (every user would
# share the proxy's address, and its per-IP rate limits).
# TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16
# Production, nginx on the host: the gateway of compose.yml's edge network,
# through which the published port reaches idp (nginx in compose.yml: its
# address, 172.30.20.10).
#   TRUSTED_PROXIES=172.30.20.1
# Optional: read this single-IP header from the proxies instead of
# X-Forwarded-For. Only one your proxy always overwrites: X-Real-IP (nginx
# realip), CF-Connecting-IP (Cloudflare).
# CLIENT_IP_HEADER=X-Real-IP

# --- Rate limits of the protocol endpoints (cmd/idp) ---
# Each as <max>/<window> (window: 30s, 1m, 15m, 1h...); unset = the default
# shown. A refused request gets 429 with Retry-After. Counted per client
# address: set TRUSTED_PROXIES first behind a proxy.
# /token, /introspect, /revoke: requests from one address that authenticate
# no client (wrong or unknown secret, or none: public clients). A client that
# proves its secret is never counted.
# RATE_LIMIT_OIDC_PER_IP=600/1m
# Failed authentications of one client_id from one address; while reached,
# that client_id is refused from that address, right secret included.
# RATE_LIMIT_OIDC_CLIENT_FAILURES_PER_IP=10/15m
# /saml/sso, /saml/login, /saml/consent, /saml/slo: requests from one address
# (a sign-in takes three).
# RATE_LIMIT_SAML_PER_IP=300/1m
# Failed sign-ins (password or passkey) from one address. A sign-in that
# succeeds is not counted: raise it when many users share one address and
# mistype at the same time (an office, a VPN).
# RATE_LIMIT_LOGIN_FAILURES_PER_IP=20/15m

# --- Password hashing ---
# Passwords are hashed with Argon2id, 64 MiB of RAM per hash. At most this
# many hashes run at the same time (default 4 = 256 MiB); other sign-ins wait.
# PASSWORD_HASH_CONCURRENCY=4

# --- Database (PostgreSQL) ---
# The servers read DATABASE_URL only. The POSTGRES_* lines build it, and the
# postgres container of compose.yml takes its password from them (user and
# database: sso).
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso
POSTGRES_DB=sso
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# Production: POSTGRES_PASSWORD=<openssl rand -hex 32> (hex: nothing to escape
# in the URL), POSTGRES_HOST=postgres. A PostgreSQL outside compose.yml: its
# URL in DATABASE_URL, with sslmode=require or stricter.

# --- Cache (Valkey) ---
# host:port, no scheme. Several, comma separated: nodes of a cluster, or the
# sentinels with VALKEY_SENTINEL_MASTER below.
VALKEY_ADDR=localhost:6379
# Production: VALKEY_ADDR=valkey:6379
# Password (requirepass, or of VALKEY_USERNAME): required when
# APP_ENV=production. compose.yml gives it to its valkey service as well.
# Production: VALKEY_PASSWORD=<openssl rand -hex 32>
# VALKEY_PASSWORD=
# A managed or shared Valkey: an ACL user of its own; TLS (the certificate
# must match the host name of VALKEY_ADDR; a private CA under ./certs); a
# logical database apart from the other applications' (not with a cluster).
# VALKEY_USERNAME=sso
# VALKEY_TLS=true
# VALKEY_TLS_CA_FILE=/certs/valkey-ca.pem
# VALKEY_DB=0
# Sentinel: VALKEY_ADDR lists the sentinels; the name of the master they
# watch, and their own password if they have one.
# VALKEY_SENTINEL_MASTER=mymaster
# VALKEY_SENTINEL_PASSWORD=

# --- Environment ---
# production requires PUBLIC_URL in https, a real key manager and SMTP sender.
APP_ENV=development
# Production: APP_ENV=production

# --- KeyManager ---
# Production uses OVH KMS (ovhkms, below). Development uses the Vault of
# `make dev`. Also supported: vault (a real Vault, docs/PRODUCTION.md) and
# local_dev (keys in memory, development only).
KEYMANAGER_BACKEND=vault
# Production: KEYMANAGER_BACKEND=ovhkms

# --- Vault (KEYMANAGER_BACKEND=vault) ---
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token
# Production: AppRole (renewed automatically) instead of VAULT_TOKEN.
# VAULT_APPROLE_ROLE_ID=
# VAULT_APPROLE_SECRET_ID=
# VAULT_APPROLE_SECRET_ID_FILE=
# VAULT_APPROLE_MOUNT=approle
# VAULT_TRANSIT_MOUNT=transit
# VAULT_NAMESPACE=
# Production with OVH KMS: delete these two lines.

# --- OVH KMS (KEYMANAGER_BACKEND=ovhkms) ---
# OVHKMS_ENDPOINT=https://eu-west-rbx.okms.ovh.net
# OVHKMS_DOMAIN_ID=00000000-0000-0000-0000-000000000000
# Certificate and private key of the KMS access. compose.yml mounts ./certs
# on /certs, read-only; the containers run as uid 65532, which must be able
# to read them.
# OVHKMS_CLIENT_CERT_FILE=/certs/<id>_certificate.pem
# OVHKMS_CLIENT_KEY_FILE=/certs/<id>_privatekey.pem

# --- MFA (Step 9) ---
# local_dev backend only: root secret of the envelope encryption keys, 32 random
# bytes in base64 (openssl rand -base64 32). Without it, TOTP secrets enrolled in
# development cannot be decrypted after a restart (users would need `idp mfa reset`).
# LOCALDEV_ENVELOPE_KEY=
# Name shown in authenticator apps (default: the realm display name).
# MFA_TOTP_ISSUER=Oh-My-SSO
# Users add, remove and list their second factors in the account console:
# <PUBLIC_URL>/r/<realm>/account/security

# --- Passkeys / WebAuthn (Step 9b) ---
# Domain passkeys are bound to (no scheme, no port). Changing it later makes every
# registered passkey unusable. Unset = passkeys disabled.
WEBAUTHN_RP_ID=localhost
# Exact origin(s) of the login pages, comma separated.
WEBAUTHN_RP_ORIGINS=http://localhost:8080
# WEBAUTHN_RP_DISPLAY_NAME=Oh-My-SSO
# Production: WEBAUTHN_RP_ID=sso.example.com, WEBAUTHN_RP_ORIGINS=https://sso.example.com

# --- OpenID Connect (Step 10) ---
# External URL of this server, as browsers and applications reach it. The issuer of
# a realm is PUBLIC_URL/r/<realm>. Required (and https only) when APP_ENV=production.
# Unset in development = http://localhost:$PORT. compose.yml gives the admin
# console PUBLIC_URL/r/master as its issuer.
# PUBLIC_URL=https://sso.example.com

# --- OIDC demo application (cmd/oidc-demo, `make oidc-demo`) ---
# `make dev-seed` prints these values.
# DEMO_ISSUER=http://localhost:8080/r/demo
# DEMO_CLIENT_ID=demo
# DEMO_CLIENT_SECRET=
# DEMO_ADDR=localhost:9000

# --- SAML 2.0 (Step 11) ---
# No setting of its own: the IdP metadata of a realm is PUBLIC_URL/r/<realm>/saml/metadata
# and its SAML signing key comes from the KeyManager above.
# Test service provider (SimpleSAMLphp in Docker): `make saml-sp`, then
# `make saml-sp-register` and open http://localhost:8081/app.php

# --- E-mail (Step 12) ---
# Development: Mailpit (started by `make docker-up`) catches every e-mail:
# open http://localhost:8025. Unset SMTP_HOST = e-mails printed in the log
# (development) or no e-mail and no "forgot password" (production).
SMTP_HOST=localhost
SMTP_PORT=1025
# starttls (port 587, default) | tls (port 465) | none (Mailpit / localhost only)
SMTP_SECURITY=none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# No quotes: make reads this file and would keep them.
SMTP_FROM=Oh-My-SSO <no-reply@localhost>
# SMTP_HELO_NAME=sso.example.com
# Production with your own mail server (e.g. Mailcow), a mailbox made for the IdP:
#   SMTP_HOST=mail.example.com SMTP_PORT=587 SMTP_SECURITY=starttls
#   SMTP_USERNAME=no-reply@example.com SMTP_PASSWORD=... SMTP_FROM=Example SSO <no-reply@example.com>
# Mail server on the same host, in another compose project: see the mailcow
# lines of compose.example.yml.
# Check the settings: make mail-test to=you@example.com
# Turn on the security alerts of a realm (off by default): make alerts-on realm=demo

# --- Languages (docs/I18N.md) ---
# Directory of extra translations, <tag>.json files (de.json, pt-br.json),
# read at start-up by idp and idp-admin: they add languages, or change texts
# of the built-in ones (English, French), without a rebuild. Unset = the
# built-in languages only. The admin console has its own directory:
# ADMIN_LOCALES_DIR (admin/.env.example). In compose.yml: /locales, with the
# commented volume of idp and idp-admin.
# LOCALES_DIR=/etc/oh-my-sso/locales

# --- Admin API and admin console (Step 14) ---
# cmd/idp-admin (`make run-admin`) serves the Admin API, called only by the
# server of the admin console (Next.js, admin/). It shares the database,
# Valkey and the KeyManager settings above with cmd/idp.
ADMIN_API_ADDR=:8090
# Who may call the Admin API (IPs or CIDRs, comma separated): the admin
# console's server only. Required when APP_ENV=production; empty = anyone (dev).
# ADMIN_API_ALLOWED_CIDRS=10.0.2.15/32
# Production: the console's fixed address in compose.yml,
#   ADMIN_API_ALLOWED_CIDRS=172.30.10.10/32
# URL of the admin console, used by `make admin-bootstrap` for the OIDC
# redirect URI of the "sso-admin" client, and for the link to the report in
# the e-mail at the end of a user import. compose.yml gives it to the console
# as its ADMIN_URL.
ADMIN_PANEL_URL=http://localhost:3000
# Production: ADMIN_PANEL_URL=https://admin.example.com
# How idp-admin reaches idp, for the dashboard's health line.
# IDP_INTERNAL_URL=http://localhost:8080
# Production: IDP_INTERNAL_URL=http://idp:8080
# true: log every Admin API call with its duration (calls of 500 ms or more
# are always logged), to find what makes a console page slow.
# ADMIN_API_LOG_REQUESTS=true
# First start: make admin-bootstrap email=you@example.com

# --- Admin console secrets (compose.yml only) ---
# The admin service of compose.yml takes them, with PUBLIC_URL and
# ADMIN_PANEL_URL. In development the console reads admin/.env.local instead
# (admin/.env.example).
# OIDC client secret printed once by the bootstrap (docs/PRODUCTION.md, step 5).
# Empty = the console answers with a configuration error.
# ADMIN_OIDC_CLIENT_SECRET=
# Encrypts the console's session cookie: openssl rand -base64 32. Changing it
# signs every admin out.
# ADMIN_SESSION_SECRET=

# --- GeoIP (Step 12, optional) ---
# Country database (.mmdb) for the "sign-in from a new country" signal.
# Free: DB-IP "IP to Country Lite" (https://db-ip.com/db/download/ip-to-country-lite)
# or MaxMind GeoLite2 Country. Unset = no country signal. In compose.yml,
# mount the file read-only in idp.
# GEOIP_DB_PATH=/path/to/dbip-country-lite.mmdb
