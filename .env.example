PORT=8080

# --- Database (PostgreSQL) ---
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso
POSTGRES_DB=sso
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- KeyManager ---
# Available backends: local_dev, vault, ovhkms
KEYMANAGER_BACKEND=vault
APP_ENV=development

# --- Vault ---
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token

# --- OVH KMS ---
# OVHKMS_ENDPOINT=https://eu-west-rbx.okms.ovh.net
# OVHKMS_DOMAIN_ID=00000000-0000-0000-0000-000000000000
# OVHKMS_CLIENT_CERT_FILE=/path/to/certificate.pem
# OVHKMS_CLIENT_KEY_FILE=/path/to/privatekey.pem
