PORT=8080

# --- Database (PostgreSQL) ---
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso
POSTGRES_DB=sso
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- KeyManager ---
# Available backends: local_dev, vault, ovhkms
KEYMANAGER_BACKEND=vault
APP_ENV=development

# --- Vault ---
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token

# --- OVH KMS ---
# OVHKMS_ENDPOINT=https://eu-west-rbx.okms.ovh.net
# OVHKMS_DOMAIN_ID=00000000-0000-0000-0000-000000000000
# OVHKMS_CLIENT_CERT_FILE=/path/to/certificate.pem
# OVHKMS_CLIENT_KEY_FILE=/path/to/privatekey.pem

# --- MFA (Step 9) ---
# local_dev backend only: root secret of the envelope encryption keys, 32 random
# bytes in base64 (openssl rand -base64 32). Without it, TOTP secrets enrolled in
# development cannot be decrypted after a restart (users would need `idp mfa reset`).
# LOCALDEV_ENVELOPE_KEY=
# Name shown in authenticator apps (default: the realm display name).
# MFA_TOTP_ISSUER=Oh-My-SSO
# APP_ENV=development also serves a test page at /r/<realm>/dev/mfa

# --- Passkeys / WebAuthn (Step 9b) ---
# Domain passkeys are bound to (no scheme, no port). Changing it later makes every
# registered passkey unusable. Unset = passkeys disabled.
WEBAUTHN_RP_ID=localhost
# Exact origin(s) of the login pages, comma separated.
WEBAUTHN_RP_ORIGINS=http://localhost:8080
# WEBAUTHN_RP_DISPLAY_NAME=Oh-My-SSO
